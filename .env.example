# Security - REQUIRED. The app refuses to start without it.
# setup.sh generates one for you; by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit or share this value - it signs every auth token.
SECRET_KEY=

# Translation API Keys (optional)
# Leave empty to use free MyMemory API
# Priority: DeepL > Google > MyMemory

# DeepL API Key (get from https://www.deepl.com/pro-api)
DEEPL_API_KEY=

# Google Translate API Key (get from https://cloud.google.com/translate)
GOOGLE_TRANSLATE_API_KEY=

# LLM (optional) - any OpenAI-compatible chat endpoint: Ollama, vLLM,
# llama.cpp server, LM Studio or a hosted API. Leave LLM_BASE_URL empty and
# every LLM feature stays off. The server checks the endpoint at start and
# every 5 minutes; Settings > Server shows whether it is available.
LLM_BASE_URL=
# e.g. LLM_BASE_URL=http://ollama:11434/v1   or   http://vllm-host:8000/v1
LLM_MODEL=
# Bearer token, if the endpoint wants one
LLM_API_KEY=
# Optional tuning (defaults shown)
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=1500
# LLM_TEMPERATURE=0.4
# Parallel requests; with several users or background grammar tagging
# raise it (4) so sentence translations don't wait
# LLM_CONCURRENCY=1
# Requests per user per day, 0 = no limit
# LLM_DAILY_LIMIT=50
# Features to offer: "all" or a comma list of grammar, explain_sentence,
# practice_text, series, quiz, word_sense, translate, ocr (ocr needs a
# model that reads images)
# LLM_FEATURES=all
# JSON merged into every request, for server-specific switches. Reasoning
# models answer much faster with reasoning off, e.g. on vLLM with Qwen:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Server Configuration
PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=*

# Reverse proxy (Caddy, nginx, ...)
# Rate limits and signup caps are keyed on the client IP. Behind a proxy
# every request arrives from the proxy's address, so the app only knows the
# real client if it trusts the proxy's X-Forwarded-For header. List the
# trusted proxy addresses here (comma-separated; exact IPs, no CIDR ranges).
# Anyone who can reach the port from one of these addresses can pick their
# own client IP, so never trust more than the proxy itself.
#   - No proxy / proxy inside the container: leave at 127.0.0.1.
#   - Proxy on the Docker host: requests come from the compose network's
#     bridge gateway (docker network inspect <project>_default, e.g.
#     172.18.0.1). Put that IP here, or set BIND_ADDRESS=127.0.0.1 below
#     and use "*" (safe only while the port is not reachable from outside).
FORWARDED_ALLOW_IPS=127.0.0.1

# Host interface the published port binds to (docker-compose.yml).
# 127.0.0.1 = only a proxy on the same host can reach the app.
BIND_ADDRESS=0.0.0.0

# Legal pages (all optional)
# Impressum: leave every IMPRESSUM_* var unset (the default) and the app
# has NO Impressum page at all — no link, no route content. Fill in
# NAME + CITY + EMAIL (the bare minimum an Anbieterkennzeichnung needs,
# e.g. under Austrian §5 ECG or German §5 TMG) and it appears at
# /impressum. STREET and ZIP are optional on top of that — leave them
# unset to publish just your place of residence instead of a full
# street address. Never commit real values here — set them in your own
# untracked .env only.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_COUNTRY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=
# Freeform extra line(s) for whatever else your jurisdiction requires
# (VAT ID, Medieninhaber/editorial-responsibility statement, supervisory
# authority, professional register, ...). Use a literal \n for line breaks.
IMPRESSUM_EXTRA=

# Privacy page: OFF by default. Its content (frontend/src/views/PrivacyView.vue)
# describes the maintainer's own demo server's specific data practices —
# which third-party translation/TTS providers it calls, its retention
# windows — and would be misleading left on, unedited, for a different
# instance. Review/rewrite it for your own deployment, then set this to
# "true" (exactly that string) to publish it.
PRIVACY_PAGE_ENABLED=