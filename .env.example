# Security - REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this

# Translation API Keys (optional)
# Leave empty to use free MyMemory API
# Priority: DeepL > Google > MyMemory

# DeepL API Key (get from https://www.deepl.com/pro-api)
DEEPL_API_KEY=

# Google Translate API Key (get from https://cloud.google.com/translate)
GOOGLE_TRANSLATE_API_KEY=

# Server Configuration
PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=*