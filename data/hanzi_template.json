{
  "qfmt": "<style>.card{font-family:'Noto Sans CJK SC',SimSun,sans-serif;text-align:center;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:white;padding:20px;border-radius:15px;box-shadow:0 8px 32px rgba(0,0,0,0.3)}.translation{font-size:24px;margin-bottom:30px;padding:15px;background:rgba(255,255,255,0.1);border-radius:10px;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2)}#target-quiz{margin:20px auto;max-width:800px}.char-container{display:inline-block;margin:8px;padding:10px;background:rgba(255,255,255,0.9);border-radius:12px;box-shadow:0 4px 15px rgba(0,0,0,0.2);transition:transform 0.3s ease}.char-container:hover{transform:scale(1.05)}.instructions{font-size:16px;margin-bottom:20px;opacity:0.9}.deck-identifier{display:none!important}</style><div class='card'><div class='translation'>{{Translation}}</div><div class='instructions'>✏️ Draw the characters stroke by stroke</div><div id='target-quiz'></div><div class='deck-identifier'>{{DeckIdentifier}}</div></div><script>var characters='{{Hanzi}}'.split('');var js=document.createElement('script');js.src='https://cdn.jsdelivr.net/npm/hanzi-writer@__HANZI_WRITER_VERSION__/dist/hanzi-writer.min.js';js.onload=function(){characters.forEach(function(char){var container=document.createElement('div');container.className='char-container';var writer=HanziWriter.create(container,char,{width:__CHARACTER_WIDTH__,height:__CHARACTER_HEIGHT__,showCharacter:false,showOutline:false,showHintAfterMisses:1,highlightOnComplete:true,highlightCompleteColor:'#4CAF50',padding:10,strokeColor:'#2196F3',radicalColor:'#FF5722',outlineColor:'#E0E0E0'});writer.quiz({onComplete:function(){container.style.background='linear-gradient(45deg,#4CAF50,#8BC34A)';setTimeout(function(){container.style.background='rgba(255,255,255,0.9)'},1500)}});document.getElementById('target-quiz').appendChild(container)})};document.body.appendChild(js);</script>",
  
  "afmt": "<style>.card{font-family:'Noto Sans CJK SC',SimSun,sans-serif;text-align:center;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:white;padding:20px;border-radius:15px;box-shadow:0 8px 32px rgba(0,0,0,0.3)}.answer-header{background:rgba(255,255,255,0.1);border-radius:10px;padding:20px;margin-bottom:25px;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2)}.translation{font-size:22px;margin-bottom:10px}.hanzi{font-size:36px;font-weight:bold;margin:10px 0;text-shadow:2px 2px 4px rgba(0,0,0,0.3)}.pinyin{font-size:18px;opacity:0.9;font-style:italic}.audio{margin-top:15px}.play-btn{background:#4CAF50;border:none;color:white;padding:10px 20px;border-radius:25px;cursor:pointer;font-size:16px;transition:all 0.3s}.play-btn:hover{background:#45a049;transform:scale(1.05)}#target-animation{margin:20px auto;max-width:600px;background:rgba(255,255,255,0.05);border-radius:15px;padding:20px}.animation-title{font-size:18px;margin-bottom:15px;opacity:0.9}.deck-identifier{display:none!important}</style><div class='card'><div class='answer-header'><div class='translation'>{{Translation}}</div><div class='hanzi'>{{Hanzi}}</div><div class='pinyin'>{{Pinyin}}</div><div class='audio'>{{Mp3}}</div></div><div class='animation-title'>🎬 Stroke Order Animation</div><div id='target-animation'></div><div class='deck-identifier'>{{DeckIdentifier}}</div></div><script>var characters='{{Hanzi}}'.split('');var js=document.createElement('script');js.src='https://cdn.jsdelivr.net/npm/hanzi-writer@__HANZI_WRITER_VERSION__/dist/hanzi-writer.min.js';js.onload=function(){var animationContainer=document.getElementById('target-animation');characters.forEach(function(char,index){setTimeout(function(){var writer=HanziWriter.create(animationContainer,char,{width:80,height:80,padding:10,showOutline:true,strokeAnimationSpeed:__STROKE_ANIMATION_SPEED__,delayBetweenStrokes:__DELAY_BETWEEN_STROKES__,strokeColor:'#2196F3',radicalColor:'#FF5722',outlineColor:'rgba(255,255,255,0.3)',highlightColor:'#4CAF50'});writer.animateCharacter()},index*1500)})};document.body.appendChild(js);</script>"
}
